
<%- include('partials/head') %>

<%- include('partials/nav') %>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    background: #f4f7f3;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
  }

  /* =========================
     PAGE HEADER
  ========================= */

  .page-header {
    background: rgba(255, 255, 255, 0.95);
    color: #1b5e20;
    padding: 20px;
    margin: 20px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .page-header h1 {
    margin: 0 0 10px;
    font-size: 32px;
  }

  .page-header p {
    font-size: 16px;
    margin: 0;
  }


  /* =========================
     PRODUCTS CONTAINER
  ========================= */

  .products-wrapper {
    width: 100%;
    max-width: 1400px;

    margin: 0 auto;
    padding: 20px;

    display: grid;

    /* 4 CARDS HORIZONTAL */
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 25px;
  }


  /* =========================
     PRODUCT CARD
  ========================= */

  .product-card {
    width: 100%;
    min-width: 0;

    background: white;

    border-radius: 18px;

    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18);

    overflow: hidden;

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-6px);

    box-shadow:
      0 18px 38px rgba(0, 0, 0, 0.22);
  }


  /* =========================
     PRODUCT IMAGE
  ========================= */

  .product-image {
    position: relative;
    width: 100%;
  }

  .product-image img {
    display: block;

    width: 100%;
    height: 210px;

    object-fit: cover;
  }


  /* =========================
     PRODUCT BADGE
  ========================= */

  .product-badge {
    position: absolute;

    top: 14px;
    left: 14px;

    background: #2e7d32;

    color: white;

    padding: 6px 12px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 700;
  }


  /* =========================
     PRODUCT INFORMATION
  ========================= */

  .product-info {
    padding: 18px;

    color: #1b5e20;
  }

  .product-info h3 {
    margin: 0 0 12px;

    font-size: 1.4rem;

    color: #1b5e20;

    word-break: break-word;
  }

  .product-info p {
    margin: 8px 0;

    color: #444;

    font-size: 0.95rem;

    line-height: 1.5;

    word-break: break-word;
  }


  /* =========================
     PRICE
  ========================= */

  .price {
    display: block;

    width: 100%;

    margin-top: 15px;
    margin-bottom: 12px;

    font-size: 1.25rem;

    font-weight: 700;

    color: #2e7d32;
  }


  /* =========================
     BUTTON ROW
  ========================= */

  .button-row {
    display: flex;

    align-items: center;

    gap: 8px;

    flex-wrap: wrap;
  }


  /* =========================
     BUTTON
  ========================= */

  .add-btn {
    display: inline-block;

    background: #2e7d32;

    color: white;

    padding: 10px 14px;

    border-radius: 10px;

    text-decoration: none;

    font-weight: 700;

    border: none;

    cursor: pointer;

    font-size: 14px;

    transition: background 0.2s ease;
  }

  .add-btn:hover {
    background: #1b5e20;
  }


  /* =========================
     DELETE BUTTON
  ========================= */

  .delete-btn {
    background: #ff0015;
  }

  .delete-btn:hover {
    background: #c90010;
  }


  /* =========================
     FORMS
  ========================= */

  .button-row form {
    display: inline-block;

    margin: 0;
  }


  /* =========================
     EMPTY MESSAGE
  ========================= */

  .empty-text {
    color: #333;

    text-align: center;

    font-size: 1.2rem;

    margin-top: 40px;
  }


  /* =========================
     LARGE TABLET
     3 CARDS
  ========================= */

  @media (max-width: 1100px) {

    .products-wrapper {
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }

  }


  /* =========================
     TABLET
     2 CARDS
  ========================= */

  @media (max-width: 768px) {

    .products-wrapper {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 18px;

      padding: 15px;
    }

    .product-image img {
      height: 190px;
    }

  }


  /* =========================
     MOBILE
     1 CARD
  ========================= */

  @media (max-width: 480px) {

    .products-wrapper {
      grid-template-columns: 1fr;

      padding: 15px;
    }

    .page-header {
      margin: 10px;
    }

    .page-header h1 {
      font-size: 26px;
    }

    .product-image img {
      height: 210px;
    }

  }
</style>


<body>


  <!-- =====================================
       PAGE HEADER
  ====================================== -->

  <main class="page-header">

    <h1>
      All Products
    </h1>

    <p>
      Here are all the products in the shop.
    </p>

  </main>



  <!-- =====================================
       PRODUCTS
  ====================================== -->

  <% if (products && products.length > 0) { %>


    <div class="products-wrapper">


      <% products.forEach(product => { %>


        <!-- =================================
             PRODUCT CARD
        ================================== -->

        <div class="product-card">


          <!-- PRODUCT IMAGE -->

          <div class="product-image">

            <img
              src="<%= product.photo || 'https://via.placeholder.com/300x200?text=No+Image' %>"
              alt="<%= product.name %>"
            >


            <!-- PRODUCT TYPE -->

            <div class="product-badge">

              <%= product.type %>

            </div>

          </div>



          <!-- =================================
               PRODUCT INFORMATION
          ================================== -->

          <div class="product-info">


            <!-- PRODUCT NAME -->

            <h3>

              <%= product.name %>

            </h3>



            <!-- CATEGORY -->

            <p>

              <b>Category:</b>

              <%= product.product %>

            </p>



            <!-- ADVANTAGES -->

            <p>

              <b>Advantages:</b>

              <%= product.advantages %>

            </p>



            <!-- CONTENTS -->

            <p>

              <b>Contents:</b>

              <%= product.contents %>

            </p>



            <!-- PRICE -->

            <span class="price">

              ₹<%= product.price %>

            </span>



            <!-- =================================
                 BUTTONS
            ================================== -->

            <div class="button-row">


              <!-- BUY BUTTON -->

              <form
                method="POST"
                action="/buy/<%= product.id %>"
              >

                <button
                  type="submit"
                  class="add-btn"
                >

                  Buy

                </button>

              </form>



              <!-- EDIT BUTTON -->

              <a
                href="/edit/<%= product.id %>"
                class="add-btn"
              >

                Edit

              </a>



              <!-- DELETE BUTTON -->

              <form
                method="POST"
                action="/delete/<%= product.id %>"
              >

                <button
                  type="submit"
                  class="add-btn delete-btn"
                >

                  Delete

                </button>

              </form>


            </div>


          </div>


        </div>


      <% }) %>


    </div>


  <% } else { %>


    <!-- NO PRODUCTS -->

    <h2 class="empty-text">

      No Products Found

    </h2>


  <% } %>


</body>

</html>

