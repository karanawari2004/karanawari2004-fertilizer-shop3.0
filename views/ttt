<%- include('partials/head') %>
<%- include('partials/nav') %>

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-image: url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee'); /* Example farm image */
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
  }

  .products-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 20px;
  }

  .product-card {
    width: 300px;
    background: white;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    overflow: hidden;
  }

  .product-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .product-card .info {
    padding: 15px;
  }

  .product-type {
    display: inline-block;
    background: #00c853;
    color: white;
    padding: 4px 8px;
    border-radius: 5px;
    font-size: 12px;
  }

  .product-price {
    color: green;
    font-weight: bold;
  }
</style>
<h1>Fertilizer Products</h1>

<div style="display:flex; flex-wrap:wrap; gap:20px;">

<% if (products && products.length > 0) { %>
  <% products.forEach(product => { %>

    <div class="w-full max-w-sm bg-neutral-primary-soft p-6 border border-default rounded-base shadow-xs">

      <!-- Product Image -->
      <img
        class="rounded-base mb-6"
        src="<%= product.photo %>"
        alt="<%= product.name %>"
        style="width:100%; height:200px; object-fit:cover;"
      />

      <!-- Rating (static) -->
      <div class="flex items-center space-x-3 mb-4">
        <span class="bg-brand-softer border border-brand-subtle text-fg-brand-strong text-xs font-medium px-2 py-1 rounded-sm">
          4.8 out of 5
        </span>
      </div>

      <!-- Product Name -->
      <h5 class="text-xl font-semibold tracking-tight">
        <%= product.name %>
      </h5>

      <!-- Product Details -->
      <p><b>Type:</b> <%= product.type %></p>
      <p><b>Category:</b> <%= product.product %></p>
      <p><b>Advantages:</b> <%= product.advantages %></p>
      <p><b>Contents:</b> <%= product.contents %></p>
      <p><b>Agreement:</b> <%= product.agreement %></p>

      <!-- Price + Button -->
      <div class="flex items-center justify-between mt-6">
        <span class="text-3xl font-extrabold text-heading">
          ₹<%= product.price %>
        </span>

        <button
          type="button"
          class="inline-flex items-center text-white bg-green-600 hover:bg-green-700 px-3 py-2 rounded-base text-sm">
          Add to cart
        </button>
      </div>

    </div>

  <% }) %>
<% } else { %>
  <p>No products available</p>
<% } %>

</div>


</div>
