<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #dbeed4;
      color: #1d3f24;
    }
    nav {
      background: rgba(70, 122, 80, 0.95);
      margin: 0;
      padding: 12px 14px;
      border-radius: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
      align-items: center;
      width: 100%;
      box-shadow: 0 10px 30px rgba(32, 80, 46, 0.14);
    }
    nav a {
      color: #f5fbf3;
      text-decoration: none;
      font-weight: 700;
      padding: 10px 16px;
      border-radius: 999px;
      transition: background 0.25s ease, transform 0.25s ease, color 0.25s ease;
      border: 1px solid transparent;
    }
    nav a:hover {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(-2px);
      color: #ffffff;
    }
    nav a.active {
      background: #3a6b44;
      border-color: rgba(255,255,255,0.24);
    }
    .nav-container {
      position: relative;
    }
    .hamburger {
      display: none;
      background: #3a6b44;
      color: white;
      border: none;
      padding: 10px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 18px;
    }
    .sidebar {
      display: none;
      position: fixed;
      top: 0;
      left: -250px;
      width: 250px;
      height: 100%;
      background: #3a6b44;
      transition: left 0.3s ease;
      z-index: 1000;
      padding-top: 60px;
    }
    .sidebar.open {
      left: 0;
    }
    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 20px;
    }
    .sidebar-nav a {
      color: white;
      text-decoration: none;
      padding: 10px;
      border-radius: 5px;
      transition: background 0.25s;
    }
    .sidebar-nav a:hover {
      background: rgba(255, 255, 255, 0.2);
    }
    .close-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: none;
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
    }
    @media (max-width: 768px) {
      nav {
        display: none;
      }
      .hamburger {
        display: block;
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 1001;
      }
      .sidebar {
        display: block;
      }
    }
    .page-header {
      background: #f1f8ee;
      border: 1px solid #c9e3c1;
      border-radius: 26px;
      padding: 40px 32px;
      max-width: 1100px;
      margin: 30px auto;
      box-shadow: 0 20px 40px rgba(34, 79, 41, 0.12);
    }
    .page-header h1 {
      margin: 0 0 18px;
      font-size: 3rem;
      line-height: 1.05;
      color: #214c2f;
    }
    .page-header p {
      margin: 0;
      color: #475b46;
      font-size: 1.1rem;
      line-height: 1.7;
    }
    .card-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }
    .card {
      background: white;
      border-radius: 22px;
      padding: 22px;
      box-shadow: 0 12px 24px rgba(86, 124, 85, 0.12);
      border: 1px solid #d6e7d2;
    }
    .card h3 {
      margin-top: 0;
      margin-bottom: 10px;
      color: #2d5f3b;
      font-size: 1.25rem;
    }
    .card p {
      margin: 0;
      color: #556c57;
      line-height: 1.7;
    }
    .action-link, .button {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 999px;
      background: #3a6b44;
      color: white;
      text-decoration: none;
      font-weight: 700;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .action-link:hover, .button:hover {
      background: #2d5938;
      transform: translateY(-1px);
    }
    .products-wrapper {
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 18px;
      padding: 18px;
      max-width: 1400px;
      margin: 0 auto 40px;
    }
    .products-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      max-width: 1400px;
      margin: 0 auto 40px;
      padding: 18px;
    }
    .product-card {
      width: 100% !important;
      min-width: 0;
      background: white;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 16px 30px rgba(28, 76, 40, 0.12);
      border: 1px solid #d6e7d0;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .product-card:hover {
      transform: translateY(-4px);
    }
    .product-image {
      position: relative;
    }
    .product-image img {
      width: 100%;
      height: 165px !important;
      object-fit: cover;
      display: block;
      background: #edf4eb;
    }
    .product-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      background: #3a6b44;
      color: white;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }
    .product-info {
      padding: 14px;
      color: #264c2e;
      flex: 1;
    }
    .product-info h3 {
      margin: 0 0 12px;
      font-size: 1.12rem;
    }
    .product-info p {
      margin: 6px 0;
      color: #4f6151;
      line-height: 1.6;
      font-size: 0.86rem;
      min-height: 42px;
    }
    .product-card .product-info > p strong,
    .product-card .product-info > p b {
      color: #2f673d;
    }
    .actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: auto;
      padding: 0 14px 14px;
    }
    .actions form {
      margin: 0 !important;
    }
    .price-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-top: 18px;
      flex-wrap: wrap;
    }
    .price {
      font-size: 1.25rem;
      font-weight: 800;
      color: #2f673d;
    }
    .empty-text {
      text-align: center;
      font-size: 1.15rem;
      color: #3f5b48;
      margin-top: 40px;
    }
    .add-btn {
      display: inline-block;
      padding: 10px 16px;
      background: #3a6b44;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background 0.25s ease, transform 0.25s ease;
      font-size: 0.9rem;
    }
    .add-btn:hover {
      background: #2f5c38;
      transform: translateY(-1px);
    }
    .buy-btn {
      background: #1f7a3f;
      color: white;
      border-radius: 12px;
      padding: 10px 16px;
    }
    .buy-btn:hover {
      background: #166233;
    }
    .add-btn[style*="background-color: #ff0015"] {
      background: #ff0015 !important;
    }
    .add-btn[style*="background-color: #ff0015"]:hover {
      background: #cc0012 !important;
    }
    .form-page {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 90px);
      padding: 40px 16px 60px;
      background: linear-gradient(135deg, #e7f1e5 0%, #d0e2cc 100%);
    }
    .form-card {
      width: min(620px, 100%);
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(57, 100, 57, 0.15);
      border-radius: 26px;
      box-shadow: 0 26px 55px rgba(32, 75, 42, 0.12);
      padding: 34px 30px;
    }
    .product-form {
      display: grid;
      gap: 18px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .text-input {
      width: 100%;
      min-height: 48px;
      padding: 14px 16px;
      border-radius: 16px;
      border: 1px solid #c9dfc6;
      background: #f7faf6;
      color: #1f3c27;
      font-size: 1rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .text-input:focus {
      outline: none;
      border-color: #6fa768;
      box-shadow: 0 0 0 4px rgba(111, 167, 104, 0.16);
      background: white;
    }
    .radio-group {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      padding: 10px 8px;
      background: #f3f7f0;
      border: 1px solid #d7e4d5;
      border-radius: 18px;
    }
    .radio-option {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 0.96rem;
      color: #334a37;
      padding: 10px 12px;
      border-radius: 14px;
      background: white;
      border: 1px solid transparent;
      transition: border-color 0.2s ease, background 0.2s ease;
    }
    .radio-option:hover {
      border-color: #c7dcc4;
      background: #f8fbf7;
    }
    .radio-option input {
      accent-color: #3a6b44;
    }
    .checkbox-field {
      display: flex;
      gap: 12px;
      align-items: center;
      padding: 14px 16px;
      border-radius: 16px;
      background: #f8faf5;
      border: 1px solid #d4e2cf;
      color: #3b553f;
      font-size: 0.98rem;
    }
    .checkbox-field input {
      width: auto;
      accent-color: #3a6b44;
    }
    .submit-button {
      width: 100%;
      padding: 16px 18px;
      border-radius: 16px;
      border: none;
      background: #3a6b44;
      color: white;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.25s ease, transform 0.25s ease;
    }
    .submit-button:hover {
      background: #2f5c38;
      transform: translateY(-1px);
    }
    .form-card .error-message {
      margin-bottom: 16px;
    }
    .product-card .price-row {
      padding: 0 14px 14px;
    }
    .card {
      min-height: 210px;
    }
    .card-row {
      margin-top: 28px;
    }
    .product-card:hover {
      box-shadow: 0 20px 38px rgba(30, 78, 39, 0.16);
    }
    .auth-page {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: calc(100vh - 90px);
      padding: 40px 16px 60px;
      background: linear-gradient(135deg, #e7f1e5 0%, #d0e2cc 100%);
    }
    @media (max-width: 1100px) {
      .products-wrapper,
      .products-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      }
    }
    @media (max-width: 768px) {
      .products-wrapper,
      .products-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 14px;
        padding: 14px;
      }
      .product-image img {
        height: 150px !important;
      }
    }
    @media (max-width: 480px) {
      .products-wrapper,
      .products-grid {
        grid-template-columns: 1fr !important;
      }
    }
    .auth-card {
      width: min(520px, 100%);
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid rgba(51, 92, 54, 0.14);
      border-radius: 24px;
      box-shadow: 0 24px 64px rgba(38, 71, 45, 0.16);
      padding: 36px 32px;
      text-align: center;
    }
    .auth-card h1 {
      margin: 0 0 16px;
      color: #1d3f24;
      font-size: 2rem;
      letter-spacing: 0.02em;
    }
    .auth-card p {
      margin: 0 0 28px;
      color: #526551;
      line-height: 1.7;
    }
    .auth-form {
      display: grid;
      gap: 18px;
      text-align: left;
    }
    .auth-input,
    .auth-button {
      width: 100%;
      border-radius: 14px;
      border: 1px solid #cfe0cf;
      padding: 14px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .auth-input:focus {
      border-color: #7db17b;
      box-shadow: 0 0 0 4px rgba(125, 177, 123, 0.14);
    }
    .auth-button {
      background: #3a6b44;
      color: white;
      border-color: transparent;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.2s ease, background 0.2s ease;
    }
    .auth-button:hover {
      background: #2f5c38;
      transform: translateY(-1px);
    }
    .auth-footer {
      margin-top: 24px;
      color: #527451;
      font-size: 0.96rem;
    }
    .auth-footer a {
      color: #2f5c38;
      font-weight: 700;
      text-decoration: none;
    }
    .error-message {
      background: #fbeae9;
      color: #9d2424;
      border: 1px solid #f2c1bf;
      border-radius: 14px;
      padding: 14px 18px;
      margin-bottom: 18px;
    }
  </style>
  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('open');
    }
  </script>
</head>
